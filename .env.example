# Copy to .env beside compose.yaml and edit. Compose reads it automatically;
# .env is gitignored, so your settings never travel with the repo.

# Your own account, so ./data stays writable and stays yours.
#   id -u ; id -g
GV_UID=1000
GV_GID=1000

# dev | prod. Use prod ONLY when an HTTPS reverse proxy sits in front of this,
# otherwise the session cookie is marked Secure and login appears to do nothing.
GV_ENV=dev

# What the container thinks "this month" is.
TZ=UTC

# Minutes an encrypted vault stays unlocked with nobody using it; the clock
# restarts every time you use it. The password lives only in memory, so a
# restart of the container locks every vault whatever this says.
GV_VAULT_TTL_MINUTES=480

# The port on the host -- change this one freely, it's what a reverse proxy
# points at. (The port inside the container stays 8080; mapping is host:container.)
GV_PORT=8080

# 127.0.0.1 keeps that port off the network entirely, reachable only by a proxy
# on the same machine. Use 0.0.0.0 to reach it directly without one.
GV_BIND=127.0.0.1
